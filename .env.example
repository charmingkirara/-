# ── Broker Selection ───────────────────────────────────────────────────────────
# Set to "oanda" or "mt5"
BROKER=oanda

# ── OANDA Credentials (BROKER=oanda) ──────────────────────────────────────────
OANDA_API_KEY=your_api_key_here
OANDA_ACCOUNT_ID=your_account_id_here
OANDA_ENVIRONMENT=practice   # "practice" or "live"

# ── MT5 Credentials (BROKER=mt5) ──────────────────────────────────────────────
MT5_LOGIN=12345678
MT5_PASSWORD=your_mt5_password
MT5_SERVER=YourBroker-Demo    # e.g. XMTrading-MT5, FXDD-Demo, etc.

# ── MT5 Trade Settings (optional — defaults shown) ────────────────────────────
MT5_SYMBOL=USDJPY
MT5_LOT_SIZE=0.01             # 0.01 lot = 1,000 units
MT5_MAGIC_NUMBER=20240101     # Unique ID to identify bot orders
MT5_DEVIATION=10              # Max slippage in points
